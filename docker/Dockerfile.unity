# Extends sandbox with Unity Editor for build verification.
# Uses game-ci images: https://game.ci/docs/docker/docker-images
#
# Build:  docker build -f docker/Dockerfile.unity -t ugb-unity .
# Run:    ./scripts/run-all.sh --agent <cmd> --label <name> --docker-image ugb-unity
#
# Requires a Unity license file at docker/license/Unity_v<version>.ulf
# Generate one with: ./docker/activate-unity.sh

ARG UNITY_VERSION=2022.3.33f1
FROM --platform=linux/amd64 unityci/editor:${UNITY_VERSION}-linux-il2cpp-3

RUN apt-get update && apt-get install -y \
    git curl jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/verify-unity.sh /verify-unity.sh
RUN chmod +x /entrypoint.sh /verify-unity.sh

# Copy license if present at build time (optional — can also mount at runtime)
ARG UNITY_VERSION=2022.3.33f1
COPY docker/license/Unity_v${UNITY_VERSION}.ul[f] /root/.local/share/unity3d/Unity/Unity_lic.ulf

ENTRYPOINT ["/entrypoint.sh"]
