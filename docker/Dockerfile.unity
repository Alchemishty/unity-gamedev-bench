# Extends sandbox with Unity Editor for build verification
# Uses game-ci images: https://game.ci/docs/docker/docker-images
# Tag format: <unity-version>-<module>-<os>
# Example: 2022.3.33f1-linux-il2cpp-3
ARG UNITY_VERSION=2022.3.33f1
FROM unityci/editor:${UNITY_VERSION}-linux-il2cpp-3

RUN apt-get update && apt-get install -y \
    git curl jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/verify-unity.sh /verify-unity.sh
RUN chmod +x /entrypoint.sh /verify-unity.sh

ENTRYPOINT ["/entrypoint.sh"]
